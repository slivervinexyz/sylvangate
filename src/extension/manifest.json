{
  "manifest_version": 3,
  "name": "SliverVine Retail Guard",
  "version": "1.0.0",
  "description": "EIP-1193 pre-consensus wallet guard — ON/OFF toggle",
  "permissions": ["storage", "activeTab"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SliverVine Retail Guard"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
