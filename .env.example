# ==============================================================================
# ALCHEMY HIGH-AVAILABILITY MULTI-CHAIN RPC & WSS (SSOT placeholders)
# Replace YOUR_ALCHEMY_API_KEY — never commit live keys.
# Worker bindings: ARB_MAINNET_RPC_URL · ARB_SEPOLIA_RPC_URL · ARBITRUM_WSS_URL
# ==============================================================================

# ── Arbitrum One (chainId 42161) — Primary Venue ──
ARB_MAINNET_RPC_URL="https://arb-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY"
ARBITRUM_WSS_URL="wss://arb-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY"

# ── Arbitrum Sepolia (chainId 421614) — Testnet Sandbox ──
ARB_SEPOLIA_RPC_URL="https://arb-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY"
ARBITRUM_SEPOLIA_WSS_URL="wss://arb-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY"

# ── Robinhood Chain — Permissioned Ingress (46630 testnet · 4663 mainnet) ──
ROBINHOOD_TESTNET_RPC_URL="https://robinhood-testnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY"
ROBINHOOD_TESTNET_WSS_URL="wss://robinhood-testnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY"
# Case A-Tier2 live-fire (46630 native escort attestation tx — never commit keys)
# RH_TESTNET_PK=0x...
ROBINHOOD_TESTNET_EXPLORER_URL="https://explorer.testnet.chain.robinhood.com"
# CONFIRM_RCHAIN_TESTNET_PROBE=YES
# BROADCAST=1
# RCHAIN_PROBE_MODE=zerodev
# ZeroDev paymaster on Robinhood Testnet 46630 (recommended — 0 ETH on signer)
# ZERODEV_PROJECT_ID="your_zerodev_project_id_here"
# Alchemy Gas Manager — optional fallback only (Bundler policy · chain 46630 · limit > $0)
# ALCHEMY_GAS_POLICY_ID="your_alchemy_gas_manager_policy_uuid"
ROBINHOOD_MAINNET_RPC_URL="https://robinhood-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY"
ROBINHOOD_MAINNET_WSS_URL="wss://robinhood-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY"
# Case A-Tier2-mainnet live-fire (4663 native escort attestation tx — never commit keys)
# RH_MAINNET_PK=0x...
ROBINHOOD_MAINNET_EXPLORER_URL="https://explorer.chain.robinhood.com"
# CONFIRM_RCHAIN_MAINNET_PROBE=YES
# BROADCAST=1
# RCHAIN_PROBE_MODE=zerodev
# ZeroDev paymaster on Robinhood Mainnet 4663 (recommended — 0 ETH on signer)
# Optional single WSS override (Sanctuary config reads ROBINHOOD_WSS_URL)
ROBINHOOD_WSS_URL=""

# ── Hyperliquid — 1× Short Hedge Venue ──
# Primary path: venue-native REST/WS (SSOT src/config/constants.ts — not Alchemy EVM RPC)
HYPERLIQUID_WSS_URL="wss://api.hyperliquid.xyz/ws"
# Optional Alchemy HA mirrors (when provisioned for institutional egress telemetry)
HYPERLIQUID_MAINNET_RPC_URL="https://hyperliquid-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY"
HYPERLIQUID_MAINNET_WSS_URL="wss://hyperliquid-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY"
HYPERLIQUID_TESTNET_RPC_URL="https://hyperliquid-testnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY"
HYPERLIQUID_TESTNET_WSS_URL="wss://hyperliquid-testnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY"

# ── Hyperliquid Session Key (Mainnet / Live Execution) ──
HYPERLIQUID_MAINNET_SESSION_PK=""

# ── Hyperliquid live execution (CI default: off) ──
# Set HL_LIVE=1 only with funded HL_TESTNET_PRIVATE_KEY for live exchange posts
HL_LIVE=0

# ── ZeroDev AA (Kernel v3 / EntryPoint v0.7) ──
ZERODEV_PROJECT_ID="your_zerodev_project_id_here"

# ── Arbiscan / block explorer (optional telemetry) ──
ARBSCAN_API="your_arbscan_api_key_here"

# ── Pgate latency fuse (reference only — NOT an env var) ──
# SSOT compile-time constant: src/config/constants.ts → PGATE_MAX_LATENCY_MS = 200